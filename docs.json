{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OwnFlow",
  "description": "Turn every payment into ownership. OwnFlow turns USDC revenue into tokenized stock ownership on Base.",
  "colors": {
    "primary": "#404E3B",
    "light": "#7B9669",
    "dark": "#333F2F"
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#F4F6F3",
      "dark": "#1A1C1C"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/mark.png",
    "dark": "/logo/mark.png",
    "href": "/"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "icon": "rocket",
        "pages": [
          "index",
          "quickstart",
          "how-it-works"
        ]
      },
      {
        "group": "Core concepts",
        "icon": "diagram-project",
        "pages": [
          "concepts/vault",
          "concepts/wallets-and-gas",
          "concepts/payment-split",
          "concepts/stock-baskets",
          "concepts/earn",
          "concepts/running-costs",
          "concepts/fees"
        ]
      },
      {
        "group": "Using OwnFlow",
        "icon": "book-open",
        "pages": [
          "guides/the-app",
          "guides/create-a-vault",
          "guides/set-your-rules",
          "guides/make-an-agent",
          "guides/get-paid",
          "guides/sell-and-withdraw",
          "guides/reports"
        ]
      },
      {
        "group": "Agents",
        "icon": "robot",
        "pages": [
          "agents/templates",
          "agents/pricing-and-payments",
          "agents/gateway"
        ]
      },
      {
        "group": "Stocks and prices",
        "icon": "chart-line",
        "pages": [
          "stocks/supported-stocks",
          "stocks/how-prices-are-checked"
        ]
      },
      {
        "group": "Safety",
        "icon": "shield-halved",
        "pages": [
          "safety/guarantees",
          "safety/pauses-and-kill-switch",
          "safety/risks",
          "safety/disclosures"
        ]
      },
      {
        "group": "Resources",
        "icon": "circle-question",
        "pages": [
          "resources/faq",
          "resources/glossary",
          "resources/networks-and-contracts"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/TheOwnflow"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/TheOwnflow"
    }
  }
}
