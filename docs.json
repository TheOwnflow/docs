{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OwnFlow",
  "description": "Turn every payment into ownership. OwnFlow turns USDC revenue into tokenized stock ownership on Base.",
  "colors": {
    "primary": "#404E3B",
    "light": "#7B9669",
    "dark": "#333F2F"
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#F4F6F3",
      "dark": "#1A1C1C"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/mark.png",
    "dark": "/logo/mark.png",
    "href": "/"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "icon": "rocket",
        "pages": [
          "index",
          "quickstart",
          "how-it-works"
        ]
      },
      {
        "group": "Your money",
        "icon": "wallet",
        "pages": [
          "concepts/payment-split",
          "concepts/stock-baskets",
          "concepts/earn",
          "concepts/running-costs",
          "concepts/fees",
          "guides/sell-and-withdraw"
        ]
      },
      {
        "group": "Agents",
        "icon": "robot",
        "pages": [
          "agents/templates",
          "guides/make-an-agent",
          "agents/pricing-and-payments"
        ]
      },
      {
        "group": "Stocks",
        "icon": "chart-line",
        "pages": [
          "stocks/supported-stocks",
          "stocks/how-prices-are-checked"
        ]
      },
      {
        "group": "Trust",
        "icon": "shield-halved",
        "pages": [
          "safety/guarantees",
          "safety/risks",
          "resources/networks-and-contracts",
          "resources/faq"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/TheOwnflow"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/TheOwnflow"
    }
  },
  "redirects": [
    {
      "source": "/guides/create-a-vault",
      "destination": "/quickstart"
    },
    {
      "source": "/guides/set-your-rules",
      "destination": "/concepts/stock-baskets"
    },
    {
      "source": "/guides/the-app",
      "destination": "/resources/faq"
    },
    {
      "source": "/guides/get-paid",
      "destination": "/agents/pricing-and-payments"
    },
    {
      "source": "/agents/gateway",
      "destination": "/agents/pricing-and-payments"
    },
    {
      "source": "/guides/reports",
      "destination": "/how-it-works"
    },
    {
      "source": "/concepts/vault",
      "destination": "/how-it-works"
    },
    {
      "source": "/concepts/wallets-and-gas",
      "destination": "/quickstart"
    },
    {
      "source": "/resources/glossary",
      "destination": "/resources/faq"
    },
    {
      "source": "/safety/pauses-and-kill-switch",
      "destination": "/safety/guarantees"
    },
    {
      "source": "/safety/upgrades",
      "destination": "/safety/guarantees"
    },
    {
      "source": "/safety/disclosures",
      "destination": "/safety/risks"
    }
  ]
}
